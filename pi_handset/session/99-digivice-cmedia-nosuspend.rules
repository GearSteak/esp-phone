# Digivice: C-Media USB audio must not autosuspend
# (Linux solid LED + silence; Windows blinks + sound)
ACTION=="add|change", SUBSYSTEM=="usb", ATTR{idVendor}=="0d8c", \
  TEST=="power/control", ATTR{power/control}="on"
ACTION=="add|change", SUBSYSTEM=="usb", ATTR{idVendor}=="0d8c", \
  TEST=="power/autosuspend_delay_ms", ATTR{power/autosuspend_delay_ms}="-1"
ACTION=="add|change", SUBSYSTEM=="usb", ATTR{idVendor}=="0d8c", \
  TEST=="power/autosuspend", ATTR{power/autosuspend}="-1"
# Sealed case: software wake on plug/boot (not physical unplug)
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="0d8c", \
  TAG+="systemd", ENV{SYSTEMD_WANTS}="digivice-cm108-wake.service"
